// Lunara build settings for the App and the widget (both targets inherit them
// from the project level).
//
// The source of the version and the build number is app/package.json
// ("version", "buildNumber"). Android reads that file directly
// (android/app/build.gradle); this file keeps the same two values for Xcode,
// and src/lib/nativeVersion.test.ts fails when they differ.
// An upload to App Store Connect needs a higher build number each time:
// raise "buildNumber" in package.json and CURRENT_PROJECT_VERSION here.
MARKETING_VERSION = 0.2.2
CURRENT_PROJECT_VERSION = 2

// The name under the icon. Info.plist reads it as $(APP_DISPLAY_NAME); the
// widget shows "$(APP_DISPLAY_NAME) Cycle".
APP_DISPLAY_NAME = Lunara

// The publik test hooks (PUBLIK_API_BASE_URL, PUBLIK_SELF_TEST; App/LunaraNativePlugin.swift)
// are compiled only into a Debug build of the App made with PUBLIK_TEST_HOOKS=YES:
//   xcodebuild ... -configuration Debug PUBLIK_TEST_HOOKS=YES   (CI test builds)
// The Release configuration never adds the Swift flag, and the "Check the Release build"
// phase (scripts/check-release-build.sh) fails an archive that has it.
PUBLIK_TEST_HOOKS = NO
LUNARA_TEST_HOOKS_CONDITION_YES = PUBLIK_TEST_HOOKS
LUNARA_TEST_HOOKS_CONDITION_NO =
LUNARA_TEST_HOOKS_CONDITION = $(LUNARA_TEST_HOOKS_CONDITION_$(PUBLIK_TEST_HOOKS))
